{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "FloodAreaSummary",
  "type": "object",
  "required": [
    "status", "place_name", "utm_epsg", "orbital_compatibility",
    "total_flood_pixels", "total_debris_pixels", "total_candidate_area_m2",
    "total_candidate_area_km2"
  ],
  "properties": {
    "status": { "type": "string", "enum": ["SUCCESS", "WARNING", "FAILED"] },
    "place_name": { "type": "string" },
    "utm_epsg": { "type": "integer" },
    "orbital_compatibility": { "type": "string", "enum": ["PASSED", "NOT_RECOMMENDED"] },
    "total_flood_pixels": { "type": "integer", "minimum": 0 },
    "total_debris_pixels": { "type": "integer", "minimum": 0 },
    "total_candidate_area_m2": { "type": "number", "minimum": 0 },
    "total_candidate_area_km2": { "type": "number", "minimum": 0 }
  }
}